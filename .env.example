# Neon PostgreSQL (Note the +psycopg dialect for SQLAlchemy + psycopg v3)
DATABASE_URL="postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Gemini API
GEMINI_API_KEY="your_gemini_api_key"

# Cloudflare R2 (Required locally for ingest.py; optional on Streamlit Cloud)
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="astrolog-images"
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Local Observer Context (Used ONLY by ingest.py; never uploaded to DB)
OBSERVER_LATITUDE="43.5890"
OBSERVER_LONGITUDE="-79.6441"
OBSERVER_ELEVATION_M="115.0"
OBSERVER_TIMEZONE="America/Toronto"